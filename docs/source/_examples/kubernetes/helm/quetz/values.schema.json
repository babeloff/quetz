{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "replicaCount",
    "image",
    "imagePullSecrets",
    "existingSecret",
    "trustedProxyIPs",
    "oidc",
    "serviceAccount",
    "persistence",
    "nodeSelector",
    "resources",
    "ingress",
    "networkPolicy"
  ],
  "properties": {
    "mode": {
      "enum": [
        "migrate",
        "serve"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "trustedProxyIPs": {
      "type": "string",
      "minLength": 1
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "clientId",
        "audience",
        "rolesClaim",
        "ownerRole",
        "maintainerRole",
        "memberRole"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "pattern": "^https://[^/]+/.+"
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "rolesClaim": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ownerRole": {
          "type": "string",
          "minLength": 1
        },
        "maintainerRole": {
          "type": "string",
          "minLength": 1
        },
        "memberRole": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "name"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingClaim",
        "size",
        "storageClass",
        "retain"
      ],
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClass": {
          "type": "string"
        },
        "retain": {
          "type": "boolean"
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "hostname",
        "tlsSecret",
        "annotations"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "tlsSecret": {
          "type": "string",
          "minLength": 1
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ingressNamespaceLabels",
        "ingressPodLabels",
        "dnsNamespaceLabels",
        "dnsPodLabels",
        "keycloakCIDRs",
        "postgresCIDRs",
        "postgresPort",
        "extraEgress"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressNamespaceLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ingressPodLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dnsNamespaceLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dnsPodLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "keycloakCIDRs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "postgresCIDRs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "postgresPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "extraEgress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft-07/schema#"
}
